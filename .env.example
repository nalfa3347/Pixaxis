# ─── Supabase ─────────────────────────────────────────────────────
# URL publique du projet Supabase (visible côté client)
NEXT_PUBLIC_SUPABASE_URL=

# Clé anonyme Supabase (visible côté client, sécurisée par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service role Supabase (SERVEUR UNIQUEMENT — jamais exposée côté client)
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI ───────────────────────────────────────────────────────
# Clé API OpenAI (SERVEUR UNIQUEMENT — jamais exposée côté client)
OPENAI_API_KEY=

# ─── FedaPay (Paiement) ────────────────────────────────────────────
# Clé secrète FedaPay (SERVEUR UNIQUEMENT — sandbox: sk_sandbox_..., live: sk_live_...)
FEDAPAY_SECRET_KEY=

# Clé publique FedaPay (pk_sandbox_... ou pk_live_...)
FEDAPAY_PUBLIC_KEY=

# Environnement FedaPay : sandbox | live
FEDAPAY_ENVIRONMENT=sandbox

# Secret du webhook FedaPay (pour vérification de signature si activée)
FEDAPAY_WEBHOOK_SECRET=

# URL publique de l'application (ex: http://localhost:3000 en local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
